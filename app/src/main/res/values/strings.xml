    <!-- Permissions -->
    <string name="perm_contacts_explain">برای انتخاب گیرنده‌ها از دفترچهٔ تلفن، فراخوان به مخاطبین شما نیاز دارد. مخاطبین هرگز از گوشی بیرون نمی‌روند.</string>
    <string name="perm_allow">اجازهٔ دسترسی</string>
    <string name="perm_sms_title">اجازهٔ ارسال پیامک</string>
    <string name="perm_sms_explain">برای فرستادن پیامک از سیم‌کارت شما، فراخوان به اجازهٔ ارسال پیامک نیاز دارد. در اندروید ۱۳ و بالاتر اجازهٔ اعلان هم برای نمایش پیشرفت ارسال خواسته می‌شود. هزینهٔ پیامک‌ها طبق تعرفهٔ سیم‌کارت شما حساب می‌شود.</string>
    <string name="perm_sms_denied_title">ارسال ممکن نیست</string>
    <string name="perm_sms_denied_text">بدون اجازهٔ ارسال پیامک، فراخوان نمی‌تواند پیام بفرستد. از تنظیمات گوشی، بخش برنامه‌ها، فراخوان، مجوزها آن را فعال کنید.</string>

